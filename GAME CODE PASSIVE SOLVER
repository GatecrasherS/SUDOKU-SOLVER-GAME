#include <iostream>

using namespace std;

#define N 9

// Checks whether it will be legal to assign num to the given row, col
bool isSafe(int grid[N][N], int row, int col, int num) {
    // Check if the same number is in the row
    for (int x = 0; x < N; x++)
        if (grid[row][x] == num)
            return false;

    // Check if the same number is in the col
    for (int x = 0; x < N; x++)
        if (grid[x][col] == num)
            return false;

    // Check if the same number is in the 3x3 box
    int startRow = row - row % 3, startCol = col - col % 3;
    for (int i = 0; i < 3; i++)
        for (int j = 0; j < 3; j++)
            if (grid[i + startRow][j + startCol] == num)
                return false;

    return true;
}

// Solves the Sudoku grid using Backtracking
bool solveSudoku(int grid[N][N], int row, int col) {
    // If we reached the 8th row and 9th column, we are done
    if (row == N - 1 && col == N)
        return true;

    // Move to next row if column value exceeds 8
    if (col == N) {
        row++;
        col = 0;
    }

    // Skip cells that are already filled
    if (grid[row][col] > 0)
        return solveSudoku(grid, row, col + 1);

    for (int num = 1; num <= 9; num++) {
        if (isSafe(grid, row, col, num)) {
            grid[row][col] = num;
            
            if (solveSudoku(grid, row, col + 1))
                return true;
        }
        // Undo assignment if it doesn't lead to a solution (Backtrack)
        grid[row][col] = 0;
    }
    return false;
}

void printGrid(int grid[N][N]) {
    for (int i = 0; i < N; i++) {
        for (int j = 0; j < N; j++)
            cout << grid[i][j] << " ";
        cout << endl;
    }
}

int main() {
    // 0 means unassigned cells
    int grid[N][N] = {
        {5, 3, 0, 0, 7, 0, 0, 0, 0},
        {6, 0, 0, 1, 9, 5, 0, 0, 0},
        {0, 9, 8, 0, 0, 0, 0, 6, 0},
        {8, 0, 0, 0, 6, 0, 0, 0, 3},
        {4, 0, 0, 8, 0, 3, 0, 0, 1},
        {7, 0, 0, 0, 2, 0, 0, 0, 6},
        {0, 6, 0, 0, 0, 0, 2, 8, 0},
        {0, 0, 0, 4, 1, 9, 0, 0, 5},
        {0, 0, 0, 0, 8, 0, 0, 7, 9}
    };

    cout << "--- Original Sudoku Board ---" << endl;
    printGrid(grid);
    cout << endl;

    if (solveSudoku(grid, 0, 0)) {
        cout << "--- Solved Sudoku Board ---" << endl;
        printGrid(grid);
    } else {
        cout << "No solution exists" << endl;
    }

    return 0;
}
